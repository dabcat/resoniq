{
  "$description": "Resoniq design tokens. Source of truth for the iOS app theme. Dark theme only for now.",
  "color": {
    "ink": { "$value": "#15132B", "$description": "App background" },
    "inkDeep": { "$value": "#0D0C1C", "$description": "Backdrop behind sheets" },
    "surface": { "$value": "#211E3F", "$description": "Cards, tab bar, secondary buttons" },
    "surfaceRaised": { "$value": "#2E2A55", "$description": "Raised fills inside a surface, tertiary buttons" },
    "line": { "$value": "#3A3566", "$description": "Hairlines, inactive dots, dashed outlines" },
    "text": { "$value": "#F6F4FF", "$description": "Primary text" },
    "textMuted": { "$value": "#BDB8DB", "$description": "Secondary text, captions. Passes 4.5:1 on ink and surface" },
    "onAccent": { "$value": "#15132B", "$description": "Text and icons on any accent fill" },
    "sun": { "$value": "#FFC83D", "$description": "Primary action, active tab, right channel" },
    "sunShadow": { "$value": "#C9921A", "$description": "Bottom edge of the primary button" },
    "sky": { "$value": "#7CC8FF", "$description": "Links, left channel, Optimize accents" },
    "lilac": { "$value": "#B69CFF", "$description": "Reso's outline, room markers, completed steps" },
    "mint": { "$value": "#7CE8B8", "$description": "Healthy / confirmed" },
    "coral": { "$value": "#FF8A7A", "$description": "Suspected defect / needs attention" }
  },
  "semantic": {
    "channelLeft": { "$value": "{color.sky}" },
    "channelRight": { "$value": "{color.sun}" },
    "resultHealthy": { "$value": "{color.mint}" },
    "resultSuspected": { "$value": "{color.coral}" },
    "resultEnvironmental": { "$value": "{color.sun}" },
    "resultInconclusive": { "$value": "{color.textMuted}", "$description": "Drawn as an outline, never a fill" }
  },
  "font": {
    "family": {
      "display": { "$value": "SF Pro Rounded", "$description": "Headings, buttons, chips, tab labels. Web mockups fall back to Nunito" },
      "text": { "$value": "SF Pro Text", "$description": "Body copy. Web mockups fall back to Inter" },
      "mono": { "$value": "SF Mono", "$description": "Measured values: Hz, dB, metres. Web mockups fall back to JetBrains Mono" }
    },
    "size": {
      "hero": { "$value": 40 },
      "title1": { "$value": 34 },
      "title2": { "$value": 28 },
      "title3": { "$value": 21 },
      "button": { "$value": 19 },
      "bodyLarge": { "$value": 17 },
      "body": { "$value": 16 },
      "callout": { "$value": 15 },
      "caption": { "$value": 13 },
      "tab": { "$value": 12 }
    },
    "weight": {
      "body": { "$value": 400 },
      "bodyStrong": { "$value": 600 },
      "label": { "$value": 700 },
      "heading": { "$value": 800 },
      "display": { "$value": 900 }
    },
    "lineHeight": {
      "heading": { "$value": 1.08 },
      "body": { "$value": 1.45 }
    }
  },
  "space": {
    "1": { "$value": 4 },
    "2": { "$value": 8 },
    "3": { "$value": 12 },
    "4": { "$value": 16 },
    "5": { "$value": 20 },
    "6": { "$value": 24 },
    "8": { "$value": 32 },
    "screenInset": { "$value": 24, "$description": "Horizontal padding of every screen" }
  },
  "radius": {
    "chip": { "$value": 16 },
    "button": { "$value": 20 },
    "row": { "$value": 22 },
    "card": { "$value": 28 },
    "cardLarge": { "$value": 32 },
    "hero": { "$value": 36 },
    "pill": { "$value": 999 }
  },
  "size": {
    "touchMin": { "$value": 44 },
    "button": { "$value": 58 },
    "chip": { "$value": 48 },
    "row": { "$value": 64 },
    "tabBarItem": { "$value": 52 },
    "tabIndicator": { "$value": [60, 30] }
  },
  "motion": {
    "spring": {
      "pop": { "$value": { "response": 0.35, "dampingFraction": 0.55 }, "$description": "Badges, checkmarks, active tab pill, selected chip" },
      "press": { "$value": { "response": 0.2, "dampingFraction": 0.7 }, "$description": "Card and row press: scale to 0.97" },
      "sheet": { "$value": { "response": 0.45, "dampingFraction": 0.8 }, "$description": "Sheets and screen content entering" },
      "settle": { "$value": { "response": 0.6, "dampingFraction": 0.6 }, "$description": "Speakers sliding into place" }
    },
    "duration": {
      "press": { "$value": 0.12 },
      "enter": { "$value": 0.6 },
      "stagger": { "$value": 0.08, "$description": "Delay between sibling entrances" }
    },
    "loop": {
      "bob": { "$value": { "period": 3.0, "distance": 10 }, "$description": "Reso idle float" },
      "blink": { "$value": { "period": 4.0 }, "$description": "Reso blink" },
      "thump": { "$value": { "period": 0.7, "scale": 1.1 }, "$description": "Woofer pulse while sound is playing" },
      "ripple": { "$value": { "period": 2.4, "fromScale": 0.7, "toScale": 1.7 }, "$description": "Sound rings" },
      "equalizer": { "$value": { "period": 0.9, "minScale": 0.3 }, "$description": "Level bars, staggered per bar" }
    }
  },
  "haptic": {
    "primaryPress": { "$value": "impact.medium" },
    "chipSelect": { "$value": "selection" },
    "tabChange": { "$value": "selection" },
    "resultHealthy": { "$value": "notification.success" },
    "resultSuspected": { "$value": "notification.warning" },
    "speakerInPlace": { "$value": "impact.rigid" }
  }
}
